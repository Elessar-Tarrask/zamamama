rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Панель доступна только пользователям с custom claim `admin: true`
    // (выдаётся скриптом functions/scripts/setAdminClaim.ts).
    // Cloud Functions работают через Admin SDK и правила обходят.
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
